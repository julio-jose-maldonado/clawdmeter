# Clawdmeter - Configuracion
# Copiar a .env y completar

# Puerto del proxy Express
PROXY_PORT=3456

# Puerto de Chrome Remote Debugging
CDP_PORT=9222

# Umbral de "zona roja" (% de uso) para las stats del historico en la PWA.
# Es el limite a partir del cual una muestra cuenta como "en rojo". Default 80.
WARN_THRESHOLD=80
