# Clawdmeter - Configuracion
# Copiar a .env y completar

# Puerto del proxy Express
PROXY_PORT=3456

# Puerto de Chrome Remote Debugging
CDP_PORT=9222

# El resto de los ajustes (brillo, umbrales, clima, etc.) NO van aca:
# se configuran desde la pagina /config.html y los guarda el proxy en su DB.
# El usuario/contrasena de esa pagina tambien se cambian ahi (default admin/clawdmeter,
# guardado hasheado con bcrypt).
